<xs:schema targetNamespace="http://www.sdmx.org/resources/sdmxml/schemas/v3_1/registry" 
			xmlns="http://www.sdmx.org/resources/sdmxml/schemas/v3_1/registry" 
			xmlns:registry="http://www.sdmx.org/resources/sdmxml/schemas/v3_1/registry" 
			xmlns:xs="http://www.w3.org/2001/XMLSchema" 
			xmlns:common="http://www.sdmx.org/resources/sdmxml/schemas/v3_1/common" 
			xmlns:structure="http://www.sdmx.org/resources/sdmxml/schemas/v3_1/structure"
			elementFormDefault="qualified">
			
	<xs:import namespace="http://www.sdmx.org/resources/sdmxml/schemas/v3_1/common" schemaLocation="SDMXCommon.xsd"/>

	<xs:annotation>
		<xs:appinfo>SDMX Base Registry Module</xs:appinfo>
		<xs:documentation>The base registry module defines the common constructs that a reused across multiple registry functions.</xs:documentation>
	</xs:annotation>

	<xs:element name="Registrations" type="RegistrationsType">
		<xs:annotation>
			<xs:documentation>Registrations is a container for data and reference metadata registrations.</xs:documentation>
		</xs:annotation>
		<xs:unique name="UniqueRegistrationID">
			<xs:annotation>
				<xs:documentation>Registry assigned registration identifiers must be unique across all data and reference metadata registrations.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="registry:DataRegistrations/registry:DataRegistration|registry:MetadataRegistrations/registry:MetadataRegistration"/>
			<xs:field xpath="@id"/>
		</xs:unique>
	</xs:element>

	<xs:complexType name="RegistrationsType">
		<xs:annotation>
			<xs:documentation>RegistrationsType describes the structure of the container for data and reference metadata registrations.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DataRegistrations" type="DataRegistrationsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>DataRegistrations contains a collection of data registrations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MetadataRegistrations" type="MetadataRegistrationsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>MetadataRegistrations contains a collection of reference metadata registrations.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="DataRegistrationsType">
		<xs:annotation>
			<xs:documentation>DataRegistrationsType describes a collection of data registrations.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DataRegistration" type="DataRegistrationType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>DataRegistration provides the details of a data registration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="MetadataRegistrationsType">
		<xs:annotation>
			<xs:documentation>MetadataRegistrationsType describes a collection of reference metadata registrations.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MetadataRegistration" type="MetadataRegistrationType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>MetadataRegistration provides the details of a reference metadata registration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="RegistrationBaseType" abstract="true">
		<xs:annotation>
			<xs:documentation>RegistrationBaseType is an abstract base type which defines the properties common to data and reference metadata registrations.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="id" type="common:IDType" use="optional">
			<xs:annotation>
				<xs:documentation>The id attribute holds a registry assigned identification for the registration. This must be provided in a response message (unless an error occurred while submitting a new registration), and should be included when updating or deleting a registration.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="lastUpdated" type="xs:dateTime" use="optional">
			<xs:annotation>
				<xs:documentation>The lastUpdated attribute provides a timestamp for the last time the registered content was updated. For a registration of files, this is the time the content of the files was last updated. For a registration of SDMX-REST APIs, where the content may change behind the API, this is the time the registration itself was last changed.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="DataRegistrationType">
		<xs:annotation>
			<xs:documentation>DataRegistrationType provides the information needed for a data registration. The registered data must be associated with a provision agreement, a dataflow, or a data structure definition. If possible, the provision agreement should be specified. Only in cases where this is not possible should the dataflow or data structure definition be used.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="RegistrationBaseType">
				<xs:sequence>
					<xs:choice>
						<xs:element name="ProvisionAgreement" type="common:ProvisionAgreementReferenceType">
							<xs:annotation>
								<xs:documentation>ProvisionAgreement provides a reference to the provision agreement that the data is being registered against.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Dataflow" type="common:DataflowReferenceType">
							<xs:annotation>
								<xs:documentation>Dataflow provides a reference to the dataflow that the data is being registered against.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="DataStructure" type="common:DataStructureReferenceType">
							<xs:annotation>
								<xs:documentation>DataStructure provides a reference to the data structure definition that the data is being registered against.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:choice>
					<xs:element name="Datasource" type="DataSourceType">
						<xs:annotation>
							<xs:documentation>Datasource identifies where the registered data can be retrieved, either as one or more files or from one or more SDMX-REST APIs.</xs:documentation>
						</xs:annotation>
						<xs:unique name="Datasource_UniqueFileURL">
							<xs:annotation>
								<xs:documentation>Each file in a registration must have a distinct url.</xs:documentation>
							</xs:annotation>
							<xs:selector xpath="registry:File"/>
							<xs:field xpath="@url"/>
						</xs:unique>
						<xs:unique name="Datasource_UniqueFileFormat">
							<xs:annotation>
								<xs:documentation>Each file in a registration must have a distinct format.</xs:documentation>
							</xs:annotation>
							<xs:selector xpath="registry:File"/>
							<xs:field xpath="@format"/>
						</xs:unique>
						<xs:unique name="Datasource_UniqueSdmxApi">
							<xs:annotation>
								<xs:documentation>Each SDMX-REST API in a registration must have a distinct combination of entry point and SDMX-REST API version.</xs:documentation>
							</xs:annotation>
							<xs:selector xpath="registry:SdmxApi"/>
							<xs:field xpath="@entryPoint"/>
							<xs:field xpath="@sdmxApiVersion"/>
						</xs:unique>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="MetadataRegistrationType">
		<xs:annotation>
			<xs:documentation>MetadataRegistrationType provides the information needed for a reference metadata registration. The registered metadata must be associated with a metadata provision agreement, a metadataflow, or a metadata structure definition. If possible, the metadata provision agreement should be specified. Only in cases where this is not possible should the metadataflow or metadata structure definition be used.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="RegistrationBaseType">
				<xs:sequence>
					<xs:choice>
						<xs:element name="MetadataProvisionAgreement" type="common:MetadataProvisionAgreementReferenceType">
							<xs:annotation>
								<xs:documentation>MetadataProvisionAgreement provides a reference to the metadata provision agreement that the metadata is being registered against.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Metadataflow" type="common:MetadataflowReferenceType">
							<xs:annotation>
								<xs:documentation>Metadataflow provides a reference to the metadataflow that the metadata is being registered against.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="MetadataStructure" type="common:MetadataStructureReferenceType">
							<xs:annotation>
								<xs:documentation>MetadataStructure provides a reference to the metadata structure definition that the metadata is being registered against.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:choice>
					<xs:element name="MetadataSource" type="MetadataSourceType">
						<xs:annotation>
							<xs:documentation>MetadataSource identifies where the registered reference metadata can be retrieved, either as one or more files or from one or more SDMX-REST APIs.</xs:documentation>
						</xs:annotation>
						<xs:unique name="MetadataSource_UniqueFileURL">
							<xs:annotation>
								<xs:documentation>Each file in a registration must have a distinct url.</xs:documentation>
							</xs:annotation>
							<xs:selector xpath="registry:File"/>
							<xs:field xpath="@url"/>
						</xs:unique>
						<xs:unique name="MetadataSource_UniqueFileFormat">
							<xs:annotation>
								<xs:documentation>Each file in a registration must have a distinct format.</xs:documentation>
							</xs:annotation>
							<xs:selector xpath="registry:File"/>
							<xs:field xpath="@format"/>
						</xs:unique>
						<xs:unique name="MetadataSource_UniqueSdmxApi">
							<xs:annotation>
								<xs:documentation>Each SDMX-REST API in a registration must have a distinct combination of entry point and SDMX-REST API version.</xs:documentation>
							</xs:annotation>
							<xs:selector xpath="registry:SdmxApi"/>
							<xs:field xpath="@entryPoint"/>
							<xs:field xpath="@sdmxApiVersion"/>
						</xs:unique>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="DataSourceType">
		<xs:annotation>
			<xs:documentation>DataSourceType specifies where data can be retrieved. Either one or more files, or one or more SDMX-REST APIs, must be specified; files and APIs cannot be mixed in the same registration. Multiple files provide the same content in different formats. Multiple APIs provide access to the same content using different versions of the SDMX-REST specification, typically at different entry points.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="File" type="common:FileDataSourceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>File describes a static SDMX data file, providing its URL and format. Where more than one file is provided, each file contains the same data in a different format, and the format should be provided for each file.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SdmxApi" type="common:SdmxApiDataSourceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>SdmxApi describes a data source that can be queried using the SDMX-REST API, providing its entry point and the version of the SDMX-REST specification it complies with. Where more than one API is provided, each provides access to the same content.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>

	<xs:complexType name="MetadataSourceType">
		<xs:annotation>
			<xs:documentation>MetadataSourceType specifies where reference metadata can be retrieved. Either one or more files, or one or more SDMX-REST APIs, must be specified; files and APIs cannot be mixed in the same registration. Multiple files provide the same content in different formats. Multiple APIs provide access to the same content using different versions of the SDMX-REST specification, typically at different entry points.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="File" type="common:FileMetadataSourceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>File describes a static SDMX reference metadata file, providing its URL and format. Where more than one file is provided, each file contains the same reference metadata in a different format, and the format should be provided for each file.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SdmxApi" type="common:SdmxApiDataSourceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>SdmxApi describes a metadata source that can be queried using the SDMX-REST API, providing its entry point and the version of the SDMX-REST specification it complies with. Where more than one API is provided, each provides access to the same content.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>

	<xs:simpleType name="IDQueryType">
		<xs:annotation>
			<xs:documentation>IDQueryType is a simple type that allows for an identifier to be substituted with a wild card character ("%").</xs:documentation>
		</xs:annotation>
		<xs:union memberTypes="common:IDType common:WildCardValueType"/>
	</xs:simpleType>

	<xs:simpleType name="NestedIDQueryType">
		<xs:annotation>
			<xs:documentation>NestedIDQueryType is a simple type that allows for a nested identifier to be substituted with a wild card character ("%").</xs:documentation>
		</xs:annotation>
		<xs:union memberTypes="common:NestedIDType common:WildCardValueType"/>
	</xs:simpleType>

	<xs:simpleType name="VersionQueryType">
		<xs:annotation>
			<xs:documentation>VersionQueryType is a simple type that allows for a version number to be substituted with a wild card character ("%") or a late bound character ("*").</xs:documentation>
		</xs:annotation>
		<xs:union memberTypes="common:WildcardVersionType common:WildCardValueType"/>
	</xs:simpleType>
	
	<xs:complexType name="IdentifiableQueryType">
		<xs:annotation>
			<xs:documentation>IdentifiableQueryType describes the structure of a query for an identifiable object.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="id" type="IDQueryType" default="%">
			<xs:annotation>
				<xs:documentation>The id attribute is used to query for an object based on its identifier. This is either an explicit value, or completely wildcarded with the "%" value.</xs:documentation>
			</xs:annotation>
		</xs:attribute>		
	</xs:complexType>
	
	<xs:complexType name="VersionableQueryType">
		<xs:annotation>
			<xs:documentation>VersionableQueryType describes the structure of a query for a versionable object.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="IdentifiableQueryType">
				<xs:attribute name="version" type="VersionQueryType" default="*">
					<xs:annotation>
						<xs:documentation>The version attribute is used to query for an object based on its version. This can be and explicit value, wild-carded ("%"), or late-bound ("*"). A wild carded version will match any version of the object where as a late-bound version will only match the latest version.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	<xs:complexType name="MaintainableQueryType">
		<xs:annotation>
			<xs:documentation>MaintainableQueryType describes the structure of a query for a maintainable object.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="VersionableQueryType">
				<xs:attribute name="agencyID" type="NestedIDQueryType" default="%">
					<xs:annotation>
						<xs:documentation>The agencyID attribute is used to query for an object based on its maintenance agency's identifier. This is either an explicit value, or completely wildcarded with the "%" value.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="StatusMessageType">
		<xs:annotation>
			<xs:documentation>StatusMessageType carries the text of error messages and/or warnings in response to queries or requests.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MessageText" type="common:StatusMessageType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>MessageText contains the text of the error and/or warning message. It can occur multiple times to communicate message for multiple warnings or errors.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="status" type="StatusType" use="required">
			<xs:annotation>
				<xs:documentation>The status attribute carries the status of the query or request.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:simpleType name="StatusType">
		<xs:annotation>
			<xs:documentation>StatusType provides an enumeration of values that detail the status of queries or requests.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="Success">
				<xs:annotation>
					<xs:documentation>Query or request successful.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Warning">
				<xs:annotation>
					<xs:documentation>Query or request successful, but with warnings.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Failure">
				<xs:annotation>
					<xs:documentation>Query or request not successful.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	
</xs:schema>