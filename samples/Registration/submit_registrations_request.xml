		<reg:RegistrationRequest action="Replace">
			<reg:MetadataRegistration id="REG_00042">
				<reg:MetadataStructure>urn:sdmx:org.sdmx.infomodel.metadatastructure.MetadataStructure=ECB:QUALITY_MSD(1.0)</reg:MetadataStructure>
