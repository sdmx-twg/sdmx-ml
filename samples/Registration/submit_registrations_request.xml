		<reg:RegistrationRequest action="Append">
			<reg:DataRegistration>
				<reg:ProvisionAgreement>urn:sdmx:org.sdmx.infomodel.registry.ProvisionAgreement=ECB:EXR_ECB(1.0)</reg:ProvisionAgreement>
				<reg:Datasource>
