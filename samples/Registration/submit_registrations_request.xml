				</reg:MetadataSource>
			</reg:MetadataRegistration>
		</reg:RegistrationRequest>
		<!-- Reference metadata registration against a metadataflow, where the metadata can be queried from an SDMX-REST API -->
		<reg:RegistrationRequest action="Append">
			<reg:MetadataRegistration>
				<reg:Metadataflow>urn:sdmx:org.sdmx.infomodel.metadatastructure.Metadataflow=ECB:QUALITY(1.0)</reg:Metadataflow>
				<reg:MetadataSource>
					<reg:SdmxApi entryPoint="https://data.example.org/sdmx/rest" sdmxApiVersion="2"/>
